# Cấu hình Nginx mẫu cho Thiệp cưới Online Anh Quân & Mai Hương
# Tài liệu tham chiếu: docs/fe/05-build-deploy-nginx.md

server {
  listen 80;
  server_name thiep.example.com;

  # Chuyển hướng toàn bộ HTTP sang HTTPS
  # Lưu ý: Bật HTTPS (ví dụ Certbot / Let's Encrypt) là bắt buộc vì nhiều webview (Zalo, Facebook)
  # và trình duyệt di động sẽ chặn âm thanh tự phát hoặc cảnh báo không an toàn.
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name thiep.example.com;

  # Đường dẫn chứa bản build dist/ sau khi giải nén / sao chép
  root /var/www/thiep/dist;
  index index.html;

  # Chứng chỉ SSL/TLS (cấu hình bởi Certbot / Let's Encrypt)
  # ssl_certificate /etc/letsencrypt/live/thiep.example.com/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/thiep.example.com/privkey.pem;

  # Bật nén gzip để tối ưu hóa tải mạng di động
  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_comp_level 6;
  gzip_types
    text/plain
    text/css
    application/javascript
    application/json
    image/svg+xml;

  # 1. Các file tĩnh trong /assets/ có hash trong tên file (JS, CSS): Cache lâu dài (1 năm, immutable)
  location ^~ /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # 2. Ảnh, âm thanh, QR, phông chữ: Cache vừa phải (30 ngày)
  # Lưu ý về Range Request: Nginx mặc định hỗ trợ HTTP Range Requests (byte-range).
  # Tuyệt đối giữ nguyên tính năng này để Safari trên iOS và webview di động phát được file âm thanh (.mp3).
  location ~* \.(webp|jpg|jpeg|png|svg|mp3|woff2)$ {
    add_header Cache-Control "public, max-age=2592000";
  }

  # 3. File index.html: Luôn luôn kiểm tra lại (no-cache) để người dùng nhận bản cập nhật mới ngay
  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  # 4. Điều hướng SPA: Trả về file tĩnh hoặc dự phòng về /index.html
  location / {
    try_files $uri $uri/ /index.html;
  }
}
